{
  "name": "athar-prototypes",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/run-local-dev.ps1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "verify:build": "npm run build && node scripts/verify-build.mjs",
    "preview": "vite preview --port 5274",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test --grep-invert @emulator",
    "test:emulator": "powershell -ExecutionPolicy Bypass -File scripts/run-emulator-tests.ps1",
    "test:emulator:run": "vitest run --config vitest.emulator.config.ts",
    "test:load:emulator": "vitest run --config vitest.emulator.config.ts tests/emulator/read-pagination.integration.test.ts",
    "test:e2e:emulator": "powershell -ExecutionPolicy Bypass -File scripts/run-emulator-playwright-tests.ps1",
    "prove:firebase-auth-real": "node scripts/prove-real-firebase-auth.mjs",
    "check:node22": "node scripts/assert-node22.mjs",
    "test:commissioning": "node scripts/commissioning/phase-a.test.mjs",
    "inventory:cloud:read": "node scripts/commissioning/inventory-cloud.mjs --project athar-dev31",
    "backup:cloud:dry": "node scripts/commissioning/backup-logical.mjs --project athar-dev31",
    "map:generate:toulouse": "powershell -ExecutionPolicy Bypass -File scripts/generate-toulouse-basemap.ps1"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@vitejs/plugin-react": "latest",
    "firebase": "latest",
    "geofire-common": "^6.0.0",
    "maplibre-gl": "5.24.0",
    "pmtiles": "^4.4.1",
    "react": "latest",
    "react-dom": "latest",
    "terra-draw": "^1.32.2",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@firebase/rules-unit-testing": "latest",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "latest",
    "@types/pngjs": "^6.0.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "latest",
    "firebase-tools": "latest",
    "pngjs": "^7.0.0",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
