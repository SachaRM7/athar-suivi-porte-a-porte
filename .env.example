# Firebase client configuration. Do not commit a populated .env.local file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development only: connects the client to the ports declared in firebase.json.
VITE_USE_FIREBASE_EMULATORS=true
VITE_WORKSPACE_ID=main
